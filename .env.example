# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/ai-teacher-assistant

# Authentication (JWT Secret)
JWT_SECRET=ai_teacher_assistant_jwt_secret_key_hackathon_2026

# AI Provider Configuration (Google Gemini)
# If no key is set, the system gracefully falls back to intelligent built-in educational generation templates
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
