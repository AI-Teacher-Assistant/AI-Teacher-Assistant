<%- include('../partials/header') %>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-badge">Instant 2-Month Free Trial</div>
      <h2>Create Teacher Account</h2>
      <p>Join thousands of educators saving hours preparing curriculum materials every week.</p>
    </div>

    <div id="registerAlert" class="alert alert-error" style="display: none;"></div>

    <form id="registerForm" class="auth-form" onsubmit="handleRegister(event)">
      <div class="form-group">
        <label for="name">Full Name</label>
        <input type="text" id="name" name="name" class="form-control" placeholder="e.g. Prof. Alan Turing" required autofocus>
      </div>

      <div class="form-group">
        <label for="email">School / Academic Email</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="e.g. aturing@cambridge.edu" required>
      </div>

      <div class="form-group">
        <label for="password">Choose Password</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="At least 6 characters" required minlength="6">
      </div>

      <div class="trial-perks-box">
        <div class="trial-perk-item">
          <span class="check-icon">✓</span> <strong>Full 60 Days:</strong> Generate notes, assignments & questions.
        </div>
        <div class="trial-perk-item">
          <span class="check-icon">✓</span> <strong>PDF Export:</strong> Download formatted student worksheets.
        </div>
        <div class="trial-perk-item">
          <span class="check-icon">✓</span> <strong>No Credit Card:</strong> Free access begins automatically.
        </div>
      </div>

      <button type="submit" id="registerSubmitBtn" class="btn btn-primary btn-block">
        <span class="btn-text">Create Account & Activate Trial</span>
        <span class="btn-spinner" style="display: none;"></span>
      </button>
    </form>

    <div class="auth-footer">
      <p>Already have an account? <a href="/login">Log in here</a></p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
